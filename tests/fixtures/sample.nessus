<?xml version="1.0" ?>
<NessusClientData_v2>
  <Policy>
    <policyName>Sample Policy</policyName>
  </Policy>
  <Report name="Sample Internal Scan">
    <ReportHost name="10.10.10.5">
      <HostProperties>
        <tag name="host-ip">10.10.10.5</tag>
        <tag name="host-fqdn">intranet.example.local</tag>
        <tag name="operating-system">Linux Kernel 5.15</tag>
      </HostProperties>
      <ReportItem port="80" svc_name="www" protocol="tcp" severity="0" pluginID="22964" pluginName="Service Detection" pluginFamily="Service detection">
        <description>A web server is running on this port.</description>
        <plugin_output>A web server is running on this port.</plugin_output>
      </ReportItem>
      <ReportItem port="80" svc_name="www" protocol="tcp" severity="2" pluginID="42057" pluginName="Web Server Allows Password Auto-Completion" pluginFamily="Web Servers">
        <description>The remote web server hosts at least one HTML form field with a password field where autocomplete is not disabled.</description>
        <plugin_output>Page : /login.php
Destination page and input name : http://10.10.10.5/login.php (password)</plugin_output>
      </ReportItem>
      <ReportItem port="22" svc_name="ssh" protocol="tcp" severity="0" pluginID="10267" pluginName="SSH Server Type and Version Information" pluginFamily="Service detection">
        <description>An SSH server is listening on this port.</description>
        <plugin_output>SSH version : SSH-2.0-OpenSSH_8.9</plugin_output>
      </ReportItem>
    </ReportHost>
    <ReportHost name="10.10.10.9">
      <HostProperties>
        <tag name="host-ip">10.10.10.9</tag>
      </HostProperties>
      <ReportItem port="443" svc_name="https" protocol="tcp" severity="0" pluginID="10863" pluginName="SSL Certificate Information" pluginFamily="General">
        <description>This plugin displays the SSL certificate.</description>
        <plugin_output>Subject Name: CN=appliance.example.local</plugin_output>
      </ReportItem>
      <ReportItem port="443" svc_name="https" protocol="tcp" severity="1" pluginID="50345" pluginName="Web Management Interface Administrator Login Page" pluginFamily="Web Servers">
        <description>The remote host runs a web management interface that presents an administrator login page.</description>
        <plugin_output>The administrator login page is : https://10.10.10.9/admin/login</plugin_output>
      </ReportItem>
    </ReportHost>
    <ReportHost name="10.10.10.30">
      <HostProperties>
        <tag name="host-ip">10.10.10.30</tag>
      </HostProperties>
      <ReportItem port="8080" svc_name="www" protocol="tcp" severity="0" pluginID="10107" pluginName="HTTP Server Type and Version" pluginFamily="Web Servers">
        <description>A web server is running on the remote host.</description>
        <plugin_output>The remote web server type is : nginx/1.24.0</plugin_output>
      </ReportItem>
    </ReportHost>
  </Report>
</NessusClientData_v2>
